PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# --- Client (Vite), only needed when the API runs on a different origin than the site ---
# VITE_API_URL=https://your-api.example.com

# --- Server (standalone deploy, e.g. Fly/Render/Railway) ---
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# ALLOWED_ORIGINS=https://your-site.example.com,https://another-site.example.com
# PORT=8787
